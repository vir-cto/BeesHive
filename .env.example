# Bee's Hive - Environment Configuration
# Copy this file to .env and fill in your values

# Data Mode:
#   'mock'    -> DEVELOPMENT/TESTING ONLY (no Firebase required; localStorage users, token counter)
#   'firebase'-> PRODUCTION (Auth + Firestore + Storage). Must also fill in all
#                VITE_FIREBASE_* vars below. With VITE_DATA_MODE=mock, Firebase is never touched.
# PRODUCTION DEPLOYMENT MUST SET: VITE_DATA_MODE=firebase
VITE_DATA_MODE=firebase

# Firebase Configuration — replace with your project's values
# Get them from Firebase Console > Project Settings > General > Your apps (Web app config).
# All seven values must belong to the SAME Firebase project.
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Google Analytics measurement ID (from Firebase Console > Project Settings)
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Optional: Firebase App Check (reCAPTCHA site key)
VITE_FIREBASE_APP_CHECK_TOKEN=

# Designated Main Admin email — DEPLOYMENT CONFIGURATION (non-secret identifier,
# NOT a credential). Used only to allow the one-time Main Admin bootstrap on a
# brand-new project. The matching value must also be created once in Firestore
# as config/bootstrap { ownerEmail: "..." } (the security rules read that
# document). Leave unset to disable the bootstrap path (an existing Main Admin
# account keeps working). Never put a password or secret here.
VITE_MAIN_ADMIN_EMAIL=beeshivefoods@gmail.com

# Print relay API key (keep secret in production .env)
VITE_PRINT_RELAY_API_KEY=

# NOTE: this file previously had a commented-out Firebase snippet for a DIFFERENT
# project pasted at the bottom. It was removed during the migration so no foreign
# project configuration can be copied into .env. All Firebase values must come
# from the active project's Web app config (see the block at the top).
